@model FishPort.ViewModels.PortDetailsViewModel
@{
    ViewData["Title"] = "漁港詳細";
}

<h2>@Model.Port.PortName</h2>

<p class="text-muted">
    @Model.PrefectureName / @Model.AreaName
</p>

<hr />

<div class="mb-4">
    <h3>漁港情報</h3>

    <p>
        <strong>住所</strong><br />
        @Model.Port.Address
    </p>

    <p>
        <strong>説明</strong><br />
        @Model.Port.Description
    </p>
</div>

<hr />

<div class="mb-4">
    <h3>コメント</h3>

    @if (Model.Comments.Any())
    {
        @foreach (var comment in Model.Comments)
        {
            <div class="card mb-3">
                <div class="card-body">

                    <strong>@comment.NickName</strong>

                    <div class="text-muted">
                        @comment.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                    </div>

                    <hr />

                    <p>
                        @comment.CommentText
                    </p>

                </div>
            </div>
        }
    }
    else
    {
        <p>まだコメントはありません。</p>
    }
</div>

<hr />

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="mb-4">
        <h3>コメントを投稿する</h3>

        <form asp-controller="Comments" asp-action="Create" method="post">

            <input type="hidden"
                   asp-for="NewComment.PortId"
                   value="@Model.Port.Id" />

            <div class="mb-3">
                <textarea asp-for="NewComment.CommentText"
                          class="form-control"
                          rows="4"
                          placeholder="コメントを入力してください">
                </textarea>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                投稿
            </button>

        </form>
    </div>
}
else
{
    <p>
        コメントを投稿するにはログインしてください。
    </p>
}

<hr />

@if (User.IsInRole("Admin"))
{
    <a asp-action="Edit"
       asp-route-id="@Model.Port.Id"
       class="btn btn-primary">
        編集
    </a>

    <a asp-action="Delete"
       asp-route-id="@Model.Port.Id"
       class="btn btn-danger">
        削除
    </a>
}

<a asp-action="Index"
   class="btn btn-secondary">
    一覧へ戻る
</a>
