@model FishPort.Models.Port

@{
    ViewData["Title"] = "Edit";
}

<form asp-action="Edit">
    <div class="mb-3">
        <label class="form-label">都道府県</label>

        <select id="prefectureSelect"
                asp-items="ViewBag.PrefectureId"
                class="form-select">

            <option value="">
                都道府県を選択してください
            </option>

        </select>
    </div>
    <div class="mb-3">
        <label asp-for="AreaId" class="form-label"></label>

        <select id="areaSelect"
                asp-for="AreaId"
                class="form-select">

            <option value="">
                先に都道府県を選択してください
            </option>

        </select>

        <span asp-validation-for="AreaId"
              class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PortName" class="form-label"></label>
        <input asp-for="PortName" class="form-control" />
        <span asp-validation-for="PortName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="6"></textarea>

        <span asp-validation-for="Description"
              class="text-danger"></span>
    </div>
    <div class="mt-4">
        <input type="submit"
               value="登録"
               class="btn btn-primary" />

        <a asp-action="Index"
           class="btn btn-secondary">
            戻る
        </a>
    </div>
</form>
@section Scripts {
    <script>
        const currentAreaId = @Model.AreaId;

        const areas = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(ViewBag.Areas)
                    );

        const prefectureSelect = document.getElementById("prefectureSelect");
        const areaSelect = document.getElementById("areaSelect");
    </script>
    <script src="~/js/prefectureAreaSelect.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }  
}
